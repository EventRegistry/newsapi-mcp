{
  "name": "newsapi-mcp",
  "version": "2.2.0",
  "description": "MCP server for NewsAPI.ai (Event Registry)",
  "author": "Event Registry d.o.o.",
  "contributors": [
    "Erik Novak"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "newsapi-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "newsapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EventRegistry/newsapi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/EventRegistry/newsapi-mcp/issues"
  },
  "homepage": "https://github.com/EventRegistry/newsapi-mcp#readme",
  "scripts": {
    "build": "tsc",
    "build:bundle": "rm -rf dist && esbuild src/index.ts --bundle --external:@napi-rs/keyring --platform=node --target=node22 --format=esm --outfile=dist/index.js",
    "build:skills": "node scripts/build-desktop-skills.js",
    "build:http": "esbuild src/http.ts --bundle --external:@napi-rs/keyring --platform=node --target=node22 --format=esm --outfile=dist/http.js \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "version": "node scripts/sync-version.js && git add src/version.ts .claude-plugin/plugin.json",
    "prepublishOnly": "node scripts/sync-version.js && npm run build:bundle"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
